<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{.Report.ReportTitle}}</title>
  <style>{{.Styles}}</style>
</head>
<body>
  <main class="shell">
    <section class="hero">
      <div class="meta">Generated {{.Report.GeneratedAt}}</div>
      <div class="cards">
        <article class="card">
          <div class="card-label">Total photos analyzed</div>
          <div class="card-value">{{.Report.Overview.TotalPhotos}}</div>
        </article>
        <article class="card">
          <div class="card-label">Top camera</div>
          <div class="card-value card-value-list">
            {{range .Report.Overview.TopCamera}}
            <div class="card-value-item">{{.}}</div>
            {{end}}
          </div>
        </article>
        <article class="card">
          <div class="card-label">Top lens</div>
          <div class="card-value card-value-list">
            {{range .Report.Overview.TopLens}}
            <div class="card-value-item">{{.}}</div>
            {{end}}
          </div>
        </article>
        <article class="card">
          <div class="card-label">Top focal length</div>
          <div class="card-value card-value-list">
            {{range .Report.Overview.TopFocal}}
            <div class="card-value-item">{{.}}</div>
            {{end}}
          </div>
        </article>
        <article class="card">
          <div class="card-label">Archive span</div>
          <div class="card-value">{{.Report.Overview.DateSpan}}</div>
        </article>
      </div>
    </section>

    <section class="section-grid">
      <article class="panel">
        <h2>Timeline</h2>
        {{if .Report.Timeline.YearBars}}
        <div class="bar-list">
          {{range .Report.Timeline.YearBars}}
          <div class="bar-row">
            <div class="bar-header"><span>{{.Label}}</span><span class="bar-value">{{.DisplayValue}}</span></div>
            <div class="bar-track"><div class="bar-fill" style="width: {{printf "%.2f" .WidthPercent}}%"></div></div>
          </div>
          {{end}}
        </div>
        {{else}}
        <div class="empty">No capture-date buckets were available for timeline rendering.</div>
        {{end}}
        {{if .Report.Timeline.HeatmapCells}}
        <div class="heatmap-wrap">
          <svg class="heatmap" viewBox="0 0 {{.Report.Timeline.HeatmapWidth}} {{.Report.Timeline.HeatmapHeight}}" role="img" aria-label="Archive activity heatmap">
            {{range .Report.Timeline.HeatmapCells}}
            <rect x="{{.X}}" y="{{.Y}}" width="{{.Width}}" height="{{.Height}}" rx="0" fill="{{.Fill}}">
              <title>{{.Label}}</title>
            </rect>
            {{end}}
          </svg>
        </div>
        {{end}}
        {{if .Report.Timeline.Note}}
        <details class="note">
          <summary>{{.Report.Timeline.Note.Summary}}</summary>
          <ul>
            {{range .Report.Timeline.Note.Details}}<li>{{.}}</li>{{end}}
          </ul>
        </details>
        {{end}}
      </article>

      <div class="metrics-grid">
        <article class="panel">
          <h3>{{.Report.Cameras.Title}}</h3>
          {{template "metric-section" .Report.Cameras}}
        </article>
        <article class="panel">
          <h3>{{.Report.Lenses.Title}}</h3>
          {{template "metric-section" .Report.Lenses}}
        </article>
        <article class="panel">
          <h3>{{.Report.ISO.Title}}</h3>
          {{template "metric-section" .Report.ISO}}
        </article>
        <article class="panel">
          <h3>{{.Report.Focal.Title}}</h3>
          {{template "metric-section" .Report.Focal}}
        </article>
        <article class="panel">
          <h3>{{.Report.Aperture.Title}}</h3>
          {{template "metric-section" .Report.Aperture}}
        </article>
        <article class="panel">
          <h3>{{.Report.Shutter.Title}}</h3>
          {{template "metric-section" .Report.Shutter}}
        </article>
      </div>
    </section>
    <div class="footer">focalytics</div>
  </main>
</body>
</html>

{{define "metric-section"}}
  {{if .Rows}}
  <div class="bar-list">
    {{range .Rows}}
    <div class="bar-row{{if .Hint}} has-hint{{end}}"{{if .Hint}} data-hint="{{.Hint}}"{{end}}>
      <div class="bar-header"><span>{{.Label}}</span><span class="bar-value">{{.DisplayValue}}</span></div>
      <div class="bar-track"><div class="bar-fill" style="width: {{printf "%.2f" .WidthPercent}}%"></div></div>
    </div>
    {{end}}
  </div>
  {{else}}
  <div class="empty">No aggregated data was available for this section.</div>
  {{end}}
  {{if .Note}}
  <details class="note">
    <summary>{{.Note.Summary}}</summary>
    <ul>
      {{range .Note.Details}}<li>{{.}}</li>{{end}}
    </ul>
  </details>
  {{end}}
{{end}}